      <value compset="2003.*_DATM%CRUJRA2024[b]*">2002</value>
      <value compset="2010.*_DATM%CRUJRA2024[b]*">2005</value>
      <value compset="1850.*_DATM%CRUv7">1901</value>
      <value compset="2000.*_DATM%CRUv7">1991</value>
